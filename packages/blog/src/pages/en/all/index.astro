---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/posts';

const lang = 'en' as const;
const [posts, articles, knowledges] = await Promise.all([
  getPosts(lang),
  getPosts(lang, 'article'),
  getPosts(lang, 'knowledge'),
]);
---

<Base
  lang={lang}
  title="all"
  description="Articles and Knowledge in one list."
  ogImage="/og/en-default.png"
  ogImageAlt="Max Kim's Knowledge Machine"
  altPath="/all"
>
  <PostList
    lang={lang}
    kind="all"
    posts={posts}
    counts={{ all: posts.length, article: articles.length, knowledge: knowledges.length }}
  />
</Base>
