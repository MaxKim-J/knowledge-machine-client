---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const lang = 'en' as const;
const [articles, knowledges] = await Promise.all([getPosts(lang, 'article'), getPosts(lang, 'knowledge')]);
---

<Base
  lang={lang}
  title="Max Kim's Knowledge Machine"
  description="Knowledge Machine is Max Kim's personal knowledge system and an ontology that uses AI to speed up knowledge processing and effectively augment knowledge."
  ogImage="/og/en-default.png"
  ogImageAlt="Max Kim's Knowledge Machine"
  altPath="/"
>
  <PostList
    lang={lang}
    kind="article"
    posts={articles}
    counts={{ article: articles.length, knowledge: knowledges.length }}
  />
</Base>
