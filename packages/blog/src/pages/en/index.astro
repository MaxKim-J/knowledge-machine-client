---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const lang = 'en' as const;
const [articles, knowledges] = await Promise.all([getPosts(lang, 'article'), getPosts(lang, 'knowledge')]);
---

<Base
  lang={lang}
  title="knowledge machine"
  description="Writing from Knowledge Machine, a personal system for understanding, learning, and creating with AI."
  altPath="/"
>
  <PostList
    lang={lang}
    kind="article"
    posts={articles}
    counts={{ article: articles.length, knowledge: knowledges.length }}
  />
</Base>
