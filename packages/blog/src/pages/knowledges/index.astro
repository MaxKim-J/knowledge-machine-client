---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const lang = 'ko' as const;
const [articles, knowledges] = await Promise.all([getPosts(lang, 'article'), getPosts(lang, 'knowledge')]);
---

<Base
  lang={lang}
  title="knowledge · knowledge machine"
  description="사실과 맥락을 중심으로 쓴 짧은 글 모음."
  altPath="/en/knowledges"
>
  <PostList lang={lang} kind="knowledge" posts={knowledges} counts={{ article: articles.length, knowledge: knowledges.length }} />
</Base>
