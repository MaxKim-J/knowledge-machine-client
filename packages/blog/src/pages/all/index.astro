---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const lang = 'ko' as const;
const [posts, articles, knowledges] = await Promise.all([
  getPosts(lang),
  getPosts(lang, 'article'),
  getPosts(lang, 'knowledge'),
]);
---

<Base
  lang={lang}
  title="all"
  description="Article과 Knowledge를 함께 모아 보여줍니다."
  ogImage="/og/default.png"
  ogImageAlt="김맥스의 지식기계"
  altPath="/en/all"
>
  <PostList
    lang={lang}
    kind="all"
    posts={posts}
    counts={{ all: posts.length, article: articles.length, knowledge: knowledges.length }}
  />
</Base>
