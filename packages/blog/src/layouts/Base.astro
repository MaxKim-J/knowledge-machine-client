---
import { ClientRouter } from 'astro:transitions';
import { withLang, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 언어 토글이 가리킬 반대 언어 경로. */
  altPath: string;
  active?: 'about' | 'author';
  /** 공유 카드 이미지의 사이트 루트 기준 경로. */
  ogImage?: string;
  /** 공유 카드 이미지의 대체 텍스트. */
  ogImageAlt?: string;
  /** 글 상세는 article, 나머지는 website. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const { lang, title, description, altPath, active, ogImage, ogImageAlt, ogType = 'website', publishedAt } = Astro.props;
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const canonical = new URL(Astro.url.pathname, Astro.site);
const DEFAULT_OG = '/og/default.png';
const image = new URL(ogImage ?? DEFAULT_OG, Astro.site);
const imageAlt = ogImageAlt ?? title;
// 크기는 기본 이미지에만 밝힌다. 글별 썸네일은 원본 크기를 알지 못한다.
const knownSize = (ogImage ?? DEFAULT_OG) === DEFAULT_OG;

const nav = [
  { key: 'about', label: 'about', href: withLang('/about', lang) },
  { key: 'author', label: 'author', href: withLang('/author', lang) },
] as const;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="knowledge machine" href={new URL('/rss.xml', Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(altPath, Astro.site)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="knowledge machine" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    {knownSize && <meta property="og:image:width" content="1200" />}
    {knownSize && <meta property="og:image:height" content="630" />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content="@max_kim_dev" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/* 본문 폰트는 스타일시트를 받은 뒤에야 요청이 시작돼 폴백으로 한 번 그려진다. 미리 받아 그 교체를 없앤다. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/packages/pretendard/dist/web/variable/woff2/PretendardVariable.woff2"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" />
    {/* 세리프 모드를 켤 때 Newsreader 와 Noto Serif KR 스타일시트를 여기에 다시 넣는다.
        비활성 상태에서는 한 글자도 렌더되지 않으면서 @font-face 선언만 635개 받는다. */}
    <ClientRouter />
  </head>
  <body>
    <div class="shell" data-serif="0">
      <header class="band head">
        <a class="brand" href={withLang('/', lang)}>
          <span>knowledge machine</span>
          <svg width="18" height="18" viewBox="0 0 16 16" style="display:block" aria-hidden="true">
            <mask id="logo-cutout" maskUnits="userSpaceOnUse">
              <rect width="16" height="16" fill="#000000"></rect>
              <circle cx="6.8" cy="8.6" r="6.2" fill="#FFFFFF"></circle>
              <circle cx="11.2" cy="4.2" r="4.6" fill="#000000"></circle>
            </mask>
            <rect width="16" height="16" fill="#000000" mask="url(#logo-cutout)"></rect>
            <rect x="9.9" y="2.3" width="3.2" height="3.2" fill="#000000"></rect>
          </svg>
        </a>
        <nav class="nav">
          {nav.map((item) => (
            <a class="swap" href={item.href}>
              <span class="ghost">{item.label}</span>
              <span class={active === item.key ? 'on' : 'off'}>{item.label}</span>
            </a>
          ))}
          <a class="swap" href={altPath} style="color:var(--dim)">
            <span class="ghost">en</span>
            <span class="off">{other}</span>
          </a>
          <a href="/rss.xml" style="color:var(--dim);text-decoration:none">
            rss
          </a>
        </nav>
      </header>

      <slot />

      <footer class="band foot">
        <span>© {new Date().getFullYear()} Jonghyuk Max Kim</span>
      </footer>
    </div>
  </body>
</html>
