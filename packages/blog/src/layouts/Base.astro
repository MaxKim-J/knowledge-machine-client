---
import { ClientRouter } from 'astro:transitions';
import { T, withLang, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 언어 토글이 가리킬 반대 언어 경로. */
  altPath: string;
  active?: 'about' | 'author';
  ogImage?: string;
}

const { lang, title, description, altPath, active, ogImage } = Astro.props;
const t = T[lang];
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage ?? '/og-default.svg', Astro.site);

const nav = [
  { key: 'about', label: 'about', href: withLang('/about', lang) },
  { key: 'author', label: 'author', href: withLang('/author', lang) },
] as const;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="knowledge machine" href={new URL('/rss.xml', Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(altPath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@max_kim_dev" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/* 본문 폰트는 스타일시트를 받은 뒤에야 요청이 시작돼 폴백으로 한 번 그려진다. 미리 받아 그 교체를 없앤다. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/packages/pretendard/dist/web/variable/woff2/PretendardVariable.woff2"
      crossorigin
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" />
    {/* 세리프 모드를 켤 때 Newsreader 와 Noto Serif KR 스타일시트를 여기에 다시 넣는다.
        비활성 상태에서는 한 글자도 렌더되지 않으면서 @font-face 선언만 635개 받는다. */}
    <ClientRouter />
  </head>
  <body>
    <div class="shell" data-serif="0">
      <header class="band head">
        <a class="brand" href={withLang('/', lang)}>
          <span>knowledge machine</span>
          <svg width="18" height="18" viewBox="0 0 16 16" style="display:block" aria-hidden="true">
            <circle cx="6.8" cy="8.6" r="6.2" fill="#000000"></circle>
            <circle cx="11.2" cy="4.2" r="4.6" fill="#FFFFFF"></circle>
            <rect x="9.9" y="2.3" width="3.2" height="3.2" fill="#000000"></rect>
          </svg>
        </a>
        <nav class="nav">
          {
            nav.map((item) => (
              <a class="swap" href={item.href}>
                <span class="ghost">{item.label}</span>
                <span class={active === item.key ? 'on' : 'off'}>{item.label}</span>
              </a>
            ))
          }
          <a class="swap" href={altPath} style="color:var(--dim)">
            <span class="ghost">en</span>
            <span class="off">{other}</span>
          </a>
          <a href="/rss.xml" style="color:var(--dim);text-decoration:none">rss</a>
        </nav>
      </header>

      <slot />

      <footer class="band foot">
        <span>© {new Date().getFullYear()} Jonghyuk Max Kim</span>
      </footer>
    </div>
  </body>
</html>
