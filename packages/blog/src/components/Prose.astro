---
// 본문 마크다운에 디자인의 블록 스타일을 태그 선택자로 적용한다.
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    font-weight: 350;
    font-size: 16.5px;
    line-height: 1.9;
    color: var(--body);
  }

  .prose > p {
    margin: 0 0 24px;
  }

  .prose h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    margin: 50px 0 14px;
    color: var(--ink);
  }

  .prose h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    margin: 38px 0 12px;
    color: var(--ink);
  }

  .prose h4,
  .prose h5,
  .prose h6 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 16.5px;
    margin: 30px 0 10px;
    color: var(--ink);
  }

  .prose strong {
    font-weight: 600;
    color: var(--ink);
  }

  .prose a {
    color: var(--ink);
    text-decoration-thickness: 1px;
  }

  .prose :not(pre) > code {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--chip);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--ink);
  }

  .prose pre {
    margin: 28px 0 26px;
    padding: 14px;
    overflow-x: auto;
    background: var(--surface) !important;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.75;
  }

  .prose pre code {
    font-family: var(--mono);
  }

  .prose blockquote {
    margin: 32px 0;
    padding: 2px 0 2px 20px;
    box-shadow: inset 2px 0 0 var(--ink);
    color: var(--ink);
    font-weight: 450;
    font-size: 16.5px;
    line-height: 1.9;
  }

  .prose blockquote > p {
    margin: 0;
  }

  .prose ul,
  .prose ol {
    margin: 4px 0 26px;
    padding-left: 22px;
  }

  .prose li {
    margin: 0 0 6px;
  }

  .prose li::marker {
    color: var(--dim);
    font-size: 13px;
  }

  .prose ul ul,
  .prose ol ol,
  .prose ul ol,
  .prose ol ul {
    margin: 6px 0 0;
    color: var(--muted);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 14px;
  }

  /* 표는 좁은 화면에서 본문 폭을 밀지 않고 스스로 가로 스크롤한다. */
  .prose .table-scroll {
    margin: 28px 0 26px;
    overflow-x: auto;
  }

  .prose th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 12px 8px 0;
    box-shadow: inset 0 -1px 0 var(--ink);
    white-space: nowrap;
  }

  .prose td {
    padding: 9px 12px 9px 0;
    color: var(--body);
    font-weight: 350;
    box-shadow: inset 0 -1px 0 var(--rule-soft);
    vertical-align: top;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .prose figure {
    margin: 34px 0 32px;
  }

  .prose figcaption {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--dim);
    margin-top: 9px;
  }

  .prose hr {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin: 40px 0;
  }
</style>
