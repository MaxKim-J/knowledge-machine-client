---
// 본문 마크다운에 디자인의 블록 스타일을 태그 선택자로 적용한다.
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    font-weight: 400;
    font-size: 16.5px;
    line-height: 1.9;
    color: var(--body);
  }

  .prose > p {
    margin: 0 0 28px;
  }

  .prose h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    margin: 56px 0 18px;
    color: var(--ink);
  }

  .prose h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    margin: 40px 0 14px;
    color: var(--ink);
  }

  .prose h4,
  .prose h5,
  .prose h6 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 16.5px;
    margin: 32px 0 12px;
    color: var(--ink);
  }

  .prose strong {
    font-weight: 600;
    color: var(--ink);
  }

  .prose a {
    color: var(--ink);
    text-decoration-thickness: 1px;
  }

  .prose :not(pre) > code {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--chip);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--ink);
  }

  .prose pre {
    margin: 32px 0 30px;
    padding: 14px;
    overflow-x: auto;
    background: var(--surface) !important;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.75;
  }

  .prose pre code {
    font-family: var(--mono);
  }

  .prose blockquote {
    margin: 38px 0;
    padding: 2px 0 2px 20px;
    box-shadow: inset 2px 0 0 var(--ink);
    color: var(--ink);
    font-weight: 500;
    font-size: 16.5px;
    line-height: 1.9;
  }

  .prose blockquote > p {
    margin: 0;
  }

  .prose ul,
  .prose ol {
    margin: 4px 0 30px;
    padding-left: 22px;
  }

  .prose li {
    margin: 0 0 6px;
  }

  .prose li::marker {
    color: var(--dim);
    font-size: 13px;
  }

  .prose ul ul,
  .prose ol ol,
  .prose ul ol,
  .prose ol ul {
    margin: 6px 0 0;
    color: var(--muted);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 14px;
  }

  /* 표는 좁은 화면에서 본문 폭을 밀지 않고 스스로 가로 스크롤한다. */
  .prose .table-scroll {
    margin: 32px 0 30px;
    overflow-x: auto;
  }

  .prose th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 12px 8px 0;
    box-shadow: inset 0 -1px 0 var(--ink);
    white-space: nowrap;
  }

  .prose td {
    padding: 9px 12px 9px 0;
    color: var(--body);
    font-weight: 400;
    box-shadow: inset 0 -1px 0 var(--rule-soft);
    vertical-align: top;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .prose figure {
    margin: 34px 0 32px;
  }

  .prose figcaption {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--dim);
    margin-top: 9px;
  }

  .prose > :first-child {
    margin-top: 0;
  }

  /* 미주 */
  .prose .note {
    position: relative;
    white-space: nowrap;
  }

  .prose .note-mark {
    font-family: var(--mono);
    font-size: 11px;
    vertical-align: super;
    text-decoration: none;
    padding: 0 1px 0 2px;
  }

  .prose .note-pop {
    position: absolute;
    bottom: 100%;
    left: 0;
    z-index: 5;
    display: none;
    width: 300px;
    max-width: calc(100vw - 32px);
    padding-bottom: 9px;
  }

  .prose .note:hover .note-pop,
  .prose .note:focus-within .note-pop {
    display: block;
  }

  .prose .note-pop-body {
    display: block;
    padding: 10px 12px;
    background: var(--bg);
    box-shadow:
      0 0 0 1px var(--ink),
      0 8px 24px rgba(0, 0, 0, 0.08);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--body);
    white-space: normal;
    text-align: left;
    vertical-align: baseline;
  }

  .prose .note-n {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
    margin-right: 6px;
  }

  .prose .note-pop-body a {
    font-size: 12px;
    word-break: break-all;
  }

  .prose .endnote-rule {
    margin-top: 40px;
    height: 1px;
    background: var(--rule);
  }

  .prose .endnotes {
    margin-top: 20px;
  }

  .prose .endnotes ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prose .endnotes li {
    display: grid;
    grid-template-columns: 26px 1fr;
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--body);
  }

  .prose .endnote-n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
  }

  .prose .endnote-host {
    font-family: var(--sans);
    font-size: 12px;
    margin-left: 6px;
    word-break: break-all;
  }

  .prose hr {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin: 40px 0;
  }
</style>

<script>
  let mermaidPromise;
  let mermaidInitialized = false;
  let mermaidId = 0;

  async function setupMermaidViewers() {
    const english = document.documentElement.lang.toLowerCase().startsWith('en');
    const fences = Array.from(
      document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"], pre:has(code.language-mermaid)'),
    ).filter((pre) => !pre.closest('.mermaid-viewer') && !pre.dataset.mermaidProcessing);
    if (!fences.length) return;
    for (const pre of fences) pre.dataset.mermaidProcessing = 'true';

    try {
      mermaidPromise ??= import('mermaid');
      const mermaid = (await mermaidPromise).default;
      if (!mermaidInitialized) {
        mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'neutral' });
        mermaidInitialized = true;
      }

      for (const pre of fences) {
        const viewer = document.createElement('div');
        viewer.className = 'mermaid-viewer';
        const toolbar = document.createElement('div');
        toolbar.className = 'mermaid-toolbar';
        const diagramLabel = document.createElement('span');
        diagramLabel.className = 'mermaid-mode mermaid-mode-diagram';
        const toggleLabel = document.createElement('label');
        toggleLabel.className = 'mermaid-switch';
        const toggle = document.createElement('input');
        toggle.type = 'checkbox';
        toggle.role = 'switch';
        toggle.setAttribute('aria-label', english ? 'Show Mermaid source code' : 'Mermaid 코드 보기');
        const track = document.createElement('span');
        track.className = 'mermaid-switch-track';
        track.setAttribute('aria-hidden', 'true');
        const thumb = document.createElement('span');
        thumb.className = 'mermaid-switch-thumb';
        track.append(thumb);
        toggleLabel.append(toggle, track);
        const codeLabel = document.createElement('span');
        codeLabel.className = 'mermaid-mode mermaid-mode-code';
        diagramLabel.textContent = english ? 'Diagram' : '도식';
        codeLabel.textContent = english ? 'Code' : '코드';
        toolbar.append(diagramLabel, toggleLabel, codeLabel);

        const output = document.createElement('div');
        output.className = 'mermaid-output';
        output.setAttribute('aria-live', 'polite');
        pre.replaceWith(viewer);
        viewer.append(toolbar, output, pre);
        const source = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        if (!source.trim()) continue;

        try {
          const result = await mermaid.render(`km-mermaid-${mermaidId++}`, source);
          output.innerHTML = result.svg;
          result.bindFunctions?.(output);
          toggle.addEventListener('change', () => {
            viewer.dataset.view = toggle.checked ? 'code' : 'diagram';
          });
          viewer.dataset.view = 'diagram';
          viewer.dataset.ready = 'true';
        } catch (cause) {
          console.warn('Mermaid diagram could not be rendered.', cause);
          const error = document.createElement('span');
          error.className = 'mermaid-error';
          error.textContent = english
            ? 'Could not render this diagram; showing source code.'
            : '도식을 표시하지 못해 코드를 보여줍니다.';
          toolbar.append(error);
          toggleLabel.hidden = true;
          diagramLabel.hidden = true;
          codeLabel.hidden = true;
          viewer.dataset.error = 'true';
        }
      }
    } catch (cause) {
      console.warn('Mermaid could not be loaded.', cause);
      for (const pre of fences) {
        const error = document.createElement('span');
        error.className = 'mermaid-error';
        error.textContent = english
          ? 'Could not load Mermaid; showing source code.'
          : '도식 기능을 불러오지 못해 코드를 보여줍니다.';
        pre.before(error);
      }
    }
  }

  document.addEventListener('astro:page-load', setupMermaidViewers);
  void setupMermaidViewers();
</script>
