---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const COPY = {
  ko: {
    title: '김맥스',
    paragraphs: [
      '프론트엔드 엔지니어. flex팀에서 웹 플랫폼과 개발 경험을 만듭니다. 모듈 연합, 개발 서버, 생성형 UI처럼 만드는 방식 자체를 바꾸는 주제를 오래 붙잡고 있습니다.',
      '읽고 걷고 달립니다. 기술 밖의 글은 대체로 사람과 노동, 도시, 음악에 관한 것입니다. 잘못된 내용을 발견하면 알려주세요.',
    ],
    feed: '전체 글 피드',
  },
  en: {
    title: 'Max Kim',
    paragraphs: [
      'Frontend engineer. I build the web platform and developer experience on the flex team. I keep returning to subjects that change how software gets made: module federation, dev servers, generative UI.',
      'I read, walk, and run. Outside of technology I mostly write about people and work, cities, and music. Tell me when something here is wrong.',
    ],
    feed: 'Full feed',
  },
} as const;

const copy = COPY[lang];

const links = [
  { label: 'github', text: 'github.com/maxkim-j', url: 'https://github.com/maxkim-j' },
  { label: 'x', text: '@max_kim_dev', url: 'https://x.com/max_kim_dev' },
  { label: 'email', text: 'hwaseen@gmail.com', url: 'mailto:hwaseen@gmail.com' },
  { label: 'rss', text: copy.feed, url: '/rss.xml' },
];
---

<main class="band">
  <h1 class="atitle">{copy.title}</h1>
  {copy.paragraphs.map((line) => <p style="margin:0 0 20px;color:var(--body)">{line}</p>)}

  <div style="display:flex;flex-direction:column;margin:32px 0 0">
    {
      links.map((link) => (
        <div class="deflist" style="padding:0 0 10px;font-size:13.5px">
          <span style="color:var(--dim)">{link.label}</span>
          <a href={link.url}>{link.text}</a>
        </div>
      ))
    }
  </div>
</main>

<style>
  .atitle {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .deflist {
    display: grid;
    grid-template-columns: 108px 1fr;
    column-gap: 20px;
    font-family: var(--sans);
  }
  @media (max-width: 600px) {
    .deflist {
      grid-template-columns: 1fr;
      row-gap: 4px;
    }
  }
</style>
