---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const COPY = {
  ko: {
    title: '김종혁',
    paragraphs: [
      'Product Engineer. flex팀에서 웹 플랫폼과 개발 경험을 만듭니다. 소프트웨어 엔지니어링으로 수 년째 생계를 꾸리고 있습니다.',
      '복잡한 문제를 삶이나 사회, 공학의 영역에서 잘 다루는 것에 관심이 많습니다. 공동체에 대해 자주 생각하고 약자가 죽지 않아도 되는 세상을 원합니다. 영문학을 전공했습니다.',
      '읽고 걷고 달립니다. 잘못된 내용을 발견하면 알려주세요.',
    ],
    feed: '전체 글 피드',
  },
  en: {
    title: 'Jonghyuk Max Kim',
    paragraphs: [
      'Product engineer. I build the web platform and developer experience on the flex team, and have earned my living through software engineering for several years.',
      'I care about handling complex problems well, in life and society as much as in engineering. I think about community often and want a world where the vulnerable do not have to die. I majored in English literature.',
      'I read, walk, and run. Tell me when something here is wrong.',
    ],
    feed: 'Full feed',
  },
} as const;

const copy = COPY[lang];

const links = [
  { label: 'github', text: 'github.com/MaxKim-J', url: 'https://github.com/MaxKim-J' },
  { label: 'x', text: '@max_kim_dev', url: 'https://x.com/max_kim_dev' },
  {
    label: 'linkedin',
    text: 'linkedin.com/in/종혁-김',
    url: 'https://www.linkedin.com/in/%EC%A2%85%ED%98%81-%EA%B9%80-903967177/',
  },
  { label: 'resume', text: 'github.com/MaxKim-J/RESUME', url: 'https://github.com/MaxKim-J/RESUME' },
  { label: 'email', text: 'hwaseen@gmail.com', url: 'mailto:hwaseen@gmail.com' },
  { label: 'rss', text: copy.feed, url: '/rss.xml' },
];
---

<main class="band">
  <h1 class="atitle">{copy.title}</h1>
  {copy.paragraphs.map((line) => (
    <p style="margin:0 0 20px;color:var(--body)">{line}</p>
  ))}

  <div style="display:flex;flex-direction:column;margin:32px 0 0">
    {links.map((link) => (
      <div class="deflist" style="padding:0 0 10px;font-size:13.5px">
        <span style="color:var(--dim)">{link.label}</span>
        <a href={link.url}>{link.text}</a>
      </div>
    ))}
  </div>
</main>

<style>
  .atitle {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .deflist {
    display: grid;
    grid-template-columns: 108px 1fr;
    column-gap: 20px;
    font-family: var(--sans);
  }
  @media (max-width: 600px) {
    .deflist {
      grid-template-columns: 1fr;
      row-gap: 4px;
    }
  }
</style>
