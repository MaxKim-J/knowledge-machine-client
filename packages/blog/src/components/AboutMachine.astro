---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const COPY = {
  ko: {
    title: '지식기계',
    lead: [
      '읽는 속도가 쓰는 속도를 앞지르면 이해하지 못한 자료가 부채처럼 쌓입니다. 지식기계는 그 부채를 남겨두지 않으려고 만든 파이프라인입니다. 자료는 네 단계를 지나며 점점 정형화됩니다. 각 단계는 고정된 스키마와 그 단계에서만 허용되는 작업을 규정합니다.',
      '저장소(knowledge-machine-database)는 옵시디언 vault이면서 코딩 에이전트의 작업장입니다. 이 블로그는 그 저장소를 읽어 정적 페이지로 빌드합니다.',
    ],
    stages: [
      {
        name: 'resource',
        desc: '유튜브 영상, 책, 아티클처럼 다시 찾아갈 수 있는 원재료.',
        note: '복사해 보관하지 않고 주소와 접근 경로만 기록',
      },
      {
        name: 'reference',
        desc: '원재료 하나를 요약과 인용, 질문과 메모로 정형화한 기록.',
        note: '발행하지 않음 · 인용 검수를 통과해야 생성',
      },
      {
        name: 'knowledge',
        desc: '사실과 맥락을 중심으로 쓰고 의견은 약하게 담은 짧은 글.',
        note: '발행 대상 · 미주로 출처 표기',
      },
      {
        name: 'article',
        desc: '논증이 복잡하고 필자의 의견과 경험이 분명하게 드러나는 글.',
        note: '발행 대상 · journal 분류 추가 사용',
      },
    ],
    sections: [
      {
        heading: '읽음 처리',
        body: '모든 reference는 읽지 않음 상태로 시작합니다. 질문과 답 또는 메모가 실제로 붙어야 읽음으로 바뀝니다. 요약만 있는 문서는 아직 읽지 않은 자료로 남습니다. 읽은 분량이 아니라 이해한 내용을 기준으로 삼으려고 두 상태를 나눕니다.',
      },
      {
        heading: '에이전트의 경계',
        body: '에이전트는 자료를 정형화하고 파일명과 스키마, 발행 상태를 관리합니다. 대신 원문에 없는 내용을 채우지 않고 제가 말하지 않은 생각을 메모로 만들지 않습니다. 판단은 사람이 하고 기계는 형식만 지킵니다. 이 경계가 무너지면 지식 대신 그럴듯한 문장만 쌓입니다.',
      },
      {
        heading: '발행 대상',
        body: '블로그에는 knowledge와 article만 올라옵니다. 둘은 같은 대분류(tech · human · culture · business · investment)를 공유하고 article만 journal을 추가로 사용합니다. reference는 발행하지 않고 짧은 평과 함께 소셜 미디어로만 공유합니다.',
      },
      {
        heading: '동기화',
        body: '이 블로그는 저장소를 서브모듈로 읽습니다. 빌드할 때마다 최신 커밋을 가져와 페이지를 다시 만들고 글을 복사해 보관하지 않으므로 원본을 고치면 다음 빌드가 그대로 따라옵니다. 어떤 글이 올라갈지는 그 글의 frontmatter가 정합니다.',
      },
    ],
  },
  en: {
    title: 'Knowledge Machine',
    lead: [
      'When reading outpaces writing, material I never understood piles up. Knowledge Machine is a pipeline built so that debt does not accumulate. Material passes through four stages, growing more structured at each one, and every stage has a fixed schema and its own permitted operations.',
      'The vault (knowledge-machine-database) is both an Obsidian workspace and a working directory for coding agents. This blog reads that repository and builds static pages from it.',
    ],
    stages: [
      {
        name: 'resource',
        desc: 'Raw material I can reach again: videos, books, articles.',
        note: 'never copied, only the address and the way back',
      },
      {
        name: 'reference',
        desc: 'One source turned into a summary, quotes, questions, and notes.',
        note: 'not published · created only when its quotes pass review',
      },
      {
        name: 'knowledge',
        desc: 'A short piece built on facts and context, with opinion kept light.',
        note: 'published · sources linked in endnotes',
      },
      {
        name: 'article',
        desc: 'A longer piece where the argument is complex and the opinion is mine.',
        note: 'published · also uses the journal category',
      },
    ],
    sections: [
      {
        heading: 'What counts as read',
        body: 'Every reference starts unread. It only turns read once a question and answer or a note is actually attached. A document with nothing but a summary stays unread. The measure is what I understood, not what I got through.',
      },
      {
        heading: 'What the agent does not do',
        body: 'Agents structure the material and maintain filenames, schemas, and publication state. They never fill in what the source does not say, and never turn thoughts I did not express into notes. People judge; the machine only keeps the form. Once that line blurs, what accumulates is plausible prose rather than knowledge.',
      },
      {
        heading: 'What gets published',
        body: 'Only knowledge and articles appear here. Both share the same top-level categories (tech · human · culture · business · investment), and only articles also use journal. References are never published, only shared on social media with a short note.',
      },
      {
        heading: 'Syncing',
        body: 'This blog reads the vault as a submodule. Every build pulls the latest commit and regenerates the pages. Nothing is copied and kept, so editing the original is enough for the next build to follow. Its own frontmatter decides whether a piece ships.',
      },
    ],
  },
} as const;

const copy = COPY[lang];
---

<main class="band">
  <h1 class="atitle">{copy.title}</h1>
  {copy.lead.map((line) => <p class="alead">{line}</p>)}

  <div style="display:flex;flex-direction:column;margin:34px 0 40px">
    {
      copy.stages.map((stage) => (
        <div class="deflist" style="padding:0 0 22px">
          <span style="font-family:var(--mono);font-size:13px;color:var(--ink);font-weight:500">{stage.name}</span>
          <span style="display:flex;flex-direction:column;gap:6px">
            <span style="font-size:16px;line-height:1.7;color:#111111">{stage.desc}</span>
            <span style="font-size:12.5px;color:var(--dim)">{stage.note}</span>
          </span>
        </div>
      ))
    }
  </div>

  {
    copy.sections.map((section, index) => (
      <>
        <h2 class="asub" style={index === 0 ? 'margin:0 0 12px' : 'margin:38px 0 12px'}>
          {section.heading}
        </h2>
        <p class="alead">{section.body}</p>
      </>
    ))
  }
</main>

<style>
  .atitle {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .asub {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .alead {
    margin: 0 0 20px;
    color: var(--body);
  }
  .deflist {
    display: grid;
    grid-template-columns: 108px 1fr;
    column-gap: 20px;
  }
  @media (max-width: 600px) {
    .deflist {
      grid-template-columns: 1fr;
      row-gap: 4px;
    }
  }
</style>
